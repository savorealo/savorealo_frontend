# ── Supabase ──────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # Solo para operaciones server-side

# ── Backend API ───────────────────────────────
API_URL=

# ── Servidor SSR (Angular Universal) ──────────
PORT=4000

# ── Entorno ───────────────────────────────────
NODE_ENV=development
